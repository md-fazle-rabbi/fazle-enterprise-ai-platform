# fazle-enterprise-ai-platform — environment template
# Copy to .env and fill in real values. Never commit .env itself.
# Populated incrementally as packages are built.

ENVIRONMENT=development
LOG_LEVEL=INFO

POSTGRES_USER=fazle
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=fazle
DATABASE_URL=

APP_DB_USER=app_user
APP_DB_PASSWORD=change_me_locally_app
APP_DATABASE_URL=

REDIS_URL=redis://localhost:6379/0

VOYAGE_API_KEY=

GEMINI_API_KEY=

HF_TOKEN=hf_your_copied_token_here

DEMO_API_KEY=fazle-demo-key

KEYCLOAK_ADMIN_PASSWORD=

LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

SLACK_WEBHOOK_URL=

KEYCLOAK_WEB_CLIENT_SECRET=change_me_locally_web_secret
DEMO_USER_PASSWORD=change_me_locally_demo_pw

# Set to false to make the backend refuse the raw X-Tenant-ID header, so only a
# Keycloak token or the demo key gets in. Left true by default because the load
# test, the RAGAS run and the research agent still use the raw header.
ALLOW_UNAUTHENTICATED_TENANT_HEADER=true