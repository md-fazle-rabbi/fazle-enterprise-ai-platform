# Base URL of the FastAPI backend. An origin only, no path. Default: http://localhost:8000
BACKEND_URL=http://localhost:8000

# The address of this web app. It must match the redirect URI registered in Keycloak.
APP_URL=http://localhost:3000

# Keycloak as the browser reaches it. Tokens carry this address as their issuer.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# Keycloak as this server reaches it. Use http://keycloak:8080 inside Docker Compose.
KEYCLOAK_INTERNAL_URL=http://localhost:8080
KEYCLOAK_REALM=agent-mesh
KEYCLOAK_CLIENT_ID=fazle-web
# Copy the value of KEYCLOAK_WEB_CLIENT_SECRET from the repo root .env into .env.local.
KEYCLOAK_WEB_CLIENT_SECRET=

# Redis for web sessions. Database 1 keeps them apart from the backend (database 0).
REDIS_URL=redis://localhost:6379/1
# How long a web session lasts, in seconds (300 to 604800). Default is 8 hours.
SESSION_TTL_SECONDS=28800