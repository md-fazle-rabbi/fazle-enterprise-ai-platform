# Base URL of the FastAPI backend. An origin only, no path. Default: http://localhost:8000
BACKEND_URL=http://localhost:8000

# Redis for web sessions. Database 1 keeps them apart from the backend (database 0).
REDIS_URL=redis://localhost:6379/1

# How long a web session lasts, in seconds (300 to 604800). Default is 8 hours.
SESSION_TTL_SECONDS=28800